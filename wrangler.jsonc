{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "venn-desk",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-15",
    // `nodejs_compat` é exigido pelo driver do Neon e pelo cliente do Prisma.
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true, "head_sampling_rate": 1 },

    // O Console é uma SPA Vite servida pelo próprio Worker (ADR 0008). O
    // `not_found_handling` é o roteamento no cliente: qualquer caminho de
    // `/console` devolve o index, e a API continua chegando ao Worker.
    "assets": {
        "directory": "./console/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    },

    // Uma sala por chamado: SSE agora, WebSocket do chat ao vivo depois.
    // O mesmo objeto, para não duplicar a lista de assinantes.
    "durable_objects": {
        "bindings": [{ "name": "SALAS", "class_name": "SalaDoChamado" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SalaDoChamado"] }],

    // Anexos. Link assinado de curta duração, e a chave carrega o app_id no
    // caminho — o escopo vale também no armazenamento (seção 10).
    "r2_buckets": [{ "binding": "ANEXOS", "bucket_name": "venn-desk-anexos" }],

    // Saída de e-mail: Cloudflare Email Sending (seção 7). Sem
    // `destination_addresses`, porque o destinatário é o usuário de cada
    // cliente — é isto que exige o plano Workers Paid.
    "send_email": [{ "name": "EMAIL" }],

    // Teto de abertura por usuário e por tenant (seção 5). Em Workers um `Map`
    // em memória não conta nada: cada isolate teria o próprio contador.
    "ratelimits": [
        {
            "name": "ABERTURA_RATE_LIMITER",
            "namespace_id": "2001",
            "simple": { "limit": 10, "period": 60 }
        }
    ],

    // A verificação de saúde de cada app (seção 7, contingência). A cada
    // minuto, que é o intervalo que o documento especifica — e o mínimo que a
    // Cloudflare aceita. Em regime normal são três UPDATEs por execução.
    "triggers": { "crons": ["* * * * *"] },

    "vars": {
        "AMBIENTE": "staging",
        // Subdomínio de envio dedicado (mail.venn360.com), já onboardado no
        // Email Sending com DKIM, SPF e DMARC p=reject próprios. Nunca o apex:
        // o MX de venn360.com é smtp.google.com e atende a caixa de entrada.
        "EMAIL_REMETENTE": "suporte@mail.venn360.com",
        "URL_BASE": "https://venn-desk.andre-7ee.workers.dev",
        // A página de status mora FORA da Cloudflare, de propósito (seção 7).
        "URL_STATUS": "https://venn360-digital.github.io/venn-desk/",
        // As origens que podem ler a API de status pelo navegador. A do Pages
        // vem primeiro porque é a que existe hoje; o domínio próprio entra
        // quando o CNAME for apontado (DNS-only, sem passar pela Cloudflare).
        // `localhost:4321` só no staging: é o preview local da página, e o
        // CORS tem de deixá-lo ler para a página ser conferida antes de
        // publicada. Fora da lista de produção, de propósito.
        "ORIGENS_DO_STATUS": "https://venn360-digital.github.io,https://status.venn360.com,http://localhost:4321",
        // O modelo do agente, trocável sem publicar código.
        //
        // Opus 5 por decisão do produto (18/11/2026): o chamado deve ser
        // respondido com excelência, e token não é a restrição.
        "MODELO_DO_AGENTE": "claude-opus-5",
        // Quanto o agente pensa antes de agir: low, medium, high, xhigh, max.
        //
        // `high` por padrão. `xhigh` e `max` existem e melhoram julgamento
        // difícil, mas cobram em LATÊNCIA — e num suporte a resposta que
        // demora dois minutos já é outra experiência para quem espera.
        "ESFORCO_DO_AGENTE": "medium",
        // Tarifa SÓ para estimar custo na trilha. Não decide nada: quem corta
        // o atendimento é o teto de passos e de tokens.
        // Tarifa do Opus, só para a estimativa da trilha.
        "TARIFA_ENTRADA_POR_MILHAO": "15",
        "TARIFA_SAIDA_POR_MILHAO": "75"
    },

    // DATABASE_URL entra por `wrangler secret put`, nunca aqui.
    "//secrets": "DATABASE_URL, SEGREDO_SESSAO, SEGREDO_LINKS, SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, ANTHROPIC_API_KEY",

    "env": {
        "producao": {
            "name": "venn-desk-producao",
            "vars": {
                "AMBIENTE": "producao",
                "EMAIL_REMETENTE": "suporte@mail.venn360.com",
                "URL_BASE": "https://desk.venn360.com",
                // Até o CNAME de status.venn360.com existir (DNS-only, sem
                // passar pela Cloudflare — proxiar devolveria a página para
                // dentro do fornecedor do qual ela foge), o alerta urgente
                // aponta para a URL do Pages, que existe.
                "URL_STATUS": "https://venn360-digital.github.io/venn-desk/",
                "ORIGENS_DO_STATUS": "https://venn360-digital.github.io,https://status.venn360.com"
            },
            "triggers": { "crons": ["* * * * *"] },
            "assets": {
                "directory": "./console/dist",
                "binding": "ASSETS",
                "not_found_handling": "single-page-application"
            },
            "r2_buckets": [
                { "binding": "ANEXOS", "bucket_name": "venn-desk-anexos-producao" }
            ],
            "durable_objects": {
                "bindings": [{ "name": "SALAS", "class_name": "SalaDoChamado" }]
            },
            "send_email": [{ "name": "EMAIL" }],
            "ratelimits": [
                {
                    "name": "ABERTURA_RATE_LIMITER",
                    "namespace_id": "2001",
                    "simple": { "limit": 10, "period": 60 }
                }
            ]
        }
    }
}
