{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "venn-desk",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-15",
    // `nodejs_compat` é exigido pelo driver do Neon e pelo cliente do Prisma.
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true, "head_sampling_rate": 1 },

    // O Console é uma SPA Vite servida pelo próprio Worker (ADR 0008). O
    // `not_found_handling` é o roteamento no cliente: qualquer caminho de
    // `/console` devolve o index, e a API continua chegando ao Worker.
    "assets": {
        "directory": "./console/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    },

    // Uma sala por chamado: SSE agora, WebSocket do chat ao vivo depois.
    // O mesmo objeto, para não duplicar a lista de assinantes.
    "durable_objects": {
        "bindings": [{ "name": "SALAS", "class_name": "SalaDoChamado" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SalaDoChamado"] }],

    // Anexos. Link assinado de curta duração, e a chave carrega o app_id no
    // caminho — o escopo vale também no armazenamento (seção 10).
    "r2_buckets": [{ "binding": "ANEXOS", "bucket_name": "venn-desk-anexos" }],

    // Saída de e-mail: Cloudflare Email Sending (seção 7). Sem
    // `destination_addresses`, porque o destinatário é o usuário de cada
    // cliente — é isto que exige o plano Workers Paid.
    "send_email": [{ "name": "EMAIL" }],

    // A fila do atendimento automático (seção 3, "Queues para tarefa longa").
    //
    // O agente leva dezenas de segundos; prendê-lo na requisição do widget
    // faria o cliente esperar a IA para ver "chamado criado". A fila separa as
    // duas coisas: a abertura responde na hora, o atendimento acontece depois.
    //
    // `max_batch_size: 1` de propósito: cada chamado é um atendimento inteiro,
    // com teto próprio, e juntar dois numa invocação faria o segundo herdar o
    // tempo gasto pelo primeiro. `max_retries: 2` porque falha de modelo
    // costuma ser transitória, e três tentativas de um atendimento que não
    // completa já é dinheiro suficiente para parar e deixar para um humano.
    "queues": {
        "producers": [{ "queue": "venn-desk-atendimento", "binding": "ATENDIMENTO" }],
        "consumers": [
            {
                "queue": "venn-desk-atendimento",
                "max_batch_size": 1,
                "max_batch_timeout": 5,
                "max_retries": 2
            }
        ]
    },

    // Teto de abertura por usuário e por tenant (seção 5). Em Workers um `Map`
    // em memória não conta nada: cada isolate teria o próprio contador.
    "ratelimits": [
        {
            "name": "ABERTURA_RATE_LIMITER",
            "namespace_id": "2001",
            "simple": { "limit": 10, "period": 60 }
        }
    ],

    // A verificação de saúde de cada app (seção 7, contingência). A cada
    // minuto, que é o intervalo que o documento especifica — e o mínimo que a
    // Cloudflare aceita. Em regime normal são três UPDATEs por execução.
    "triggers": { "crons": ["* * * * *"] },

    "vars": {
        "AMBIENTE": "staging",
        // Subdomínio de envio dedicado (mail.venn360.com), já onboardado no
        // Email Sending com DKIM, SPF e DMARC p=reject próprios. Nunca o apex:
        // o MX de venn360.com é smtp.google.com e atende a caixa de entrada.
        "EMAIL_REMETENTE": "suporte@mail.venn360.com",
        "URL_BASE": "https://venn-desk.andre-7ee.workers.dev",
        // A página de status mora FORA da Cloudflare, de propósito (seção 7).
        "URL_STATUS": "https://venn360-digital.github.io/venn-desk/",
        // As origens que podem ler a API de status pelo navegador. A do Pages
        // vem primeiro porque é a que existe hoje; o domínio próprio entra
        // quando o CNAME for apontado (DNS-only, sem passar pela Cloudflare).
        // `localhost:4321` só no staging: é o preview local da página, e o
        // CORS tem de deixá-lo ler para a página ser conferida antes de
        // publicada. Fora da lista de produção, de propósito.
        "ORIGENS_DO_STATUS": "https://venn360-digital.github.io,https://status.venn360.com,http://localhost:4321",
        // As origens dos apps que embutem o widget. Staging do Desk aceita só
        // o homolog dos apps; produção, só produção. Cruzar os dois faria um
        // widget de homolog abrir chamado no banco do cliente.
        "ORIGENS_DOS_APPS": "https://homolog-odontobox.venn360.com,https://homolog-conecta.venn360.com,https://homolog-stagent.venn360.com,http://localhost:3000",
        // O modelo do agente, trocável sem publicar código.
        //
        // Sonnet 5 (18/11/2026). O Opus foi medido em chamado real e custou
        // ~8x — US$ 1,18 contra US$ 0,14 — sem diferença de desfecho que
        // justificasse: nos dois casos o agente diagnosticou, respondeu e
        // escalou certo. O que o Opus deu de melhor foi redação; o que decidiu
        // o atendimento foi a ferramenta devolver bom contexto, e isso o
        // Sonnet tem igual.
        "MODELO_DO_AGENTE": "claude-sonnet-5",
        // Quanto o agente pensa antes de agir: low, medium, high, xhigh, max.
        //
        // `high` por padrão. `xhigh` e `max` existem e melhoram julgamento
        // difícil, mas cobram em LATÊNCIA — e num suporte a resposta que
        // demora dois minutos já é outra experiência para quem espera.
        "ESFORCO_DO_AGENTE": "medium",
        // Tarifa SÓ para estimar custo na trilha. Não decide nada: quem corta
        // o atendimento é o teto de passos e de tokens.
        // Tarifa do Sonnet, só para a estimativa da trilha.
        "TARIFA_ENTRADA_POR_MILHAO": "3",
        "TARIFA_SAIDA_POR_MILHAO": "15"
    },

    // DATABASE_URL entra por `wrangler secret put`, nunca aqui.
    "//secrets": "DATABASE_URL, SEGREDO_SESSAO, SEGREDO_LINKS, SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, ANTHROPIC_API_KEY",

    "env": {
        "producao": {
            "name": "venn-desk-producao",
            // O domínio próprio. `custom_domain: true` faz o wrangler criar o
            // registro na zona venn360.com no deploy — é o caminho oficial, e
            // evita um CNAME escrito à mão que ninguém lembra de onde veio.
            //
            // Isto É proxiado pela Cloudflare, e tudo bem: o Console e a API
            // SÃO a Cloudflare. Quem não pode passar por ela é a página de
            // status (ver ADR 0010).
            "routes": [{ "pattern": "desk.venn360.com", "custom_domain": true }],
            "vars": {
                "AMBIENTE": "producao",
                "EMAIL_REMETENTE": "suporte@mail.venn360.com",
                "URL_BASE": "https://desk.venn360.com",
                // Até o CNAME de status.venn360.com existir (DNS-only, sem
                // passar pela Cloudflare — proxiar devolveria a página para
                // dentro do fornecedor do qual ela foge), o alerta urgente
                // aponta para a URL do Pages, que existe.
                "URL_STATUS": "https://venn360-digital.github.io/venn-desk/",
                "ORIGENS_DO_STATUS": "https://venn360-digital.github.io,https://status.venn360.com",
                "ORIGENS_DOS_APPS": "https://odontobox.venn360.com,https://conecta.venn360.com,https://stagent.venn360.com",
                "MODELO_DO_AGENTE": "claude-sonnet-5",
                "ESFORCO_DO_AGENTE": "medium",
                "TARIFA_ENTRADA_POR_MILHAO": "3",
                "TARIFA_SAIDA_POR_MILHAO": "15"
            },
            "triggers": { "crons": ["* * * * *"] },
            "assets": {
                "directory": "./console/dist",
                "binding": "ASSETS",
                "not_found_handling": "single-page-application"
            },
            "r2_buckets": [
                { "binding": "ANEXOS", "bucket_name": "venn-desk-anexos-producao" }
            ],
            // Fila PRÓPRIA. Compartilhar a de staging faria um chamado de
            // teste ser atendido pelo Worker de produção, com o banco de
            // produção — e um aceite meu viraria gasto e escrita no ambiente
            // do cliente.
            "queues": {
                "producers": [
                    { "queue": "venn-desk-atendimento-producao", "binding": "ATENDIMENTO" }
                ],
                "consumers": [
                    {
                        "queue": "venn-desk-atendimento-producao",
                        "max_batch_size": 1,
                        "max_batch_timeout": 5,
                        "max_retries": 2
                    }
                ]
            },
            // As mesmas chaves do agente. O modelo e o esforço são decisão de
            // produto e valem nos dois ambientes.
            "//vars-do-agente": "MODELO_DO_AGENTE, ESFORCO_DO_AGENTE e as tarifas entram abaixo",
            "durable_objects": {
                "bindings": [{ "name": "SALAS", "class_name": "SalaDoChamado" }]
            },
            "send_email": [{ "name": "EMAIL" }],
            "ratelimits": [
                {
                    "name": "ABERTURA_RATE_LIMITER",
                    "namespace_id": "2001",
                    "simple": { "limit": 10, "period": 60 }
                }
            ]
        }
    }
}
